<Window
    x:Class="SelectColor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SelectColor"
    Width="560"
    Height="650"
    MinWidth="560"
    MinHeight="480"
    Background="#0D0E0F"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  Paleta neutra: sin tinte azulado para no interferir con la percepcion del color  -->
        <SolidColorBrush x:Key="BgBrush" Color="#0F1011" />
        <SolidColorBrush x:Key="CardBrush" Color="#17181D" />
        <SolidColorBrush x:Key="LineBrush" Color="#282A2E" />
        <SolidColorBrush x:Key="LineSoftBrush" Color="#222224" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#A2A4A6" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B6B6B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="FieldBrush" Color="#141516" />

        <!--  Acentos: solo en valores y controles, nunca en superficies  -->
        <SolidColorBrush x:Key="Amber" Color="#E3B341" />
        <SolidColorBrush x:Key="Rose" Color="#F08A8A" />
        <SolidColorBrush x:Key="Violet" Color="#B79CF0" />
        <SolidColorBrush x:Key="Mint" Color="#6FD3A8" />
        <SolidColorBrush x:Key="Sky" Color="#6BAEE8" />

        <LinearGradientBrush x:Key="bg_degrade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#1C1D20" />
            <GradientStop Offset="1.0" Color="#181A1F" />
        </LinearGradientBrush>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--  Boton principal: gris medio, legible sin blindingar  -->
        <Style x:Key="AppButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E6EAF0" />
            <Setter Property="Background" Value="{StaticResource bg_degrade}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#4A4C50"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D2D2D2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#AEAEAE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Boton secundario: fondo claro medio, texto claro y borde visible  -->
        <Style
            x:Key="GhostButton"
            BasedOn="{StaticResource AppButton}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource bg_degrade}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#4A4C50"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#404245" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#64666A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#5A5A5A" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{StaticResource FieldBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="10,0"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RgbSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
        </Style>

        <!--  Boton con tinte: fondo oscuro, borde y texto del color asignado  -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title  -->
        <StackPanel Grid.Row="0" Margin="4,0,4,14">
            <TextBlock Style="{StaticResource TitleText}" Text="SelectColor" />
            <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource HintText}"
                Text="Selector de color" />
        </StackPanel>

        <!--  Preview + Formats  -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Width="140"
                Height="140"
                Margin="0,0,14,0"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="2"
                CornerRadius="12">
                <Border.Background>
                    <SolidColorBrush x:Name="ColorPreviewBrush" Color="#FFFFFF" />
                </Border.Background>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border
                        x:Name="PreviewOverlay"
                        Width="80"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#B3000000"
                        CornerRadius="6"
                        Opacity="0.6" />
                    <TextBlock
                        x:Name="PreviewLabel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Text="#FFFFFF" />
                </Grid>

            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Amber}"
                            Text="HEX" />
                        <TextBlock
                            x:Name="HexValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource Amber}"
                            Style="{StaticResource ValueText}"
                            Text="#FFFFFF" />
                    </Grid>
                </Border>
                <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Rose}"
                            Text="RGB" />
                        <TextBlock
                            x:Name="RgbValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{StaticResource Rose}"
                            Style="{StaticResource ValueText}"
                            Text="255, 255, 255" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Violet}"
                            Text="HSL" />
                        <TextBlock
                            x:Name="HslValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{StaticResource Violet}"
                            Style="{StaticResource ValueText}"
                            Text="0, 0%, 100%" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!--  Controls  -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource LabelText}"
                                    Text="CÓDIGO HEX" />

                                <!--  Botones Copiar/Pegar  -->
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                                    <CheckBox
                                        x:Name="chkIncludeHash"
                                        Margin="0,0"
                                        VerticalAlignment="Center"
                                        Content="Incluir #"
                                        Foreground="White" />
                                    <Button
                                        Width="130"
                                        Margin="10,0,10,0"
                                        Padding="12,0"
                                        Click="CopyHex_Click"
                                        Content="Copiar"
                                        Style="{StaticResource GhostButton}" />
                                    <Button
                                        x:Name="PasteHexBtn"
                                        Width="130"
                                        Padding="12,0"
                                        Click="PasteHex_Click"
                                        Content="Pegar"
                                        Style="{StaticResource GhostButton}" />

                                </StackPanel>

                            </Grid>

                            <DockPanel Grid.Row="2">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Foreground="Orange"
                                    Text="#" />

                                <TextBox
                                    x:Name="HexTextBox"
                                    HorizontalAlignment="Stretch"
                                    PreviewTextInput="HexTextBox_PreviewTextInput"
                                    Style="{StaticResource AppTextBox}"
                                    Text="#FFFFFF"
                                    TextChanged="HexTextBox_TextChanged" />
                            </DockPanel>


                        </Grid>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Width="130"
                            Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="R" />
                            <Slider
                                x:Name="SliderR"
                                Margin="0,4,0,10"
                                Foreground="#E05A5A"
                                Style="{StaticResource RgbSlider}"
                                ValueChanged="Slider_ValueChanged"
                                Value="255" />
                            <TextBlock Style="{StaticResource LabelText}" Text="G" />
                            <Slider
                                x:Name="SliderG"
                                Margin="0,4,0,10"
                                Foreground="#5FBF7F"
                                Style="{StaticResource RgbSlider}"
                                ValueChanged="Slider_ValueChanged"
                                Value="255" />
                            <TextBlock Style="{StaticResource LabelText}" Text="B" />
                            <Slider
                                x:Name="SliderB"
                                Margin="0,4,0,0"
                                Foreground="#5A8FD6"
                                Style="{StaticResource RgbSlider}"
                                ValueChanged="Slider_ValueChanged"
                                Value="255" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontFamily="Segoe UI"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextDimBrush}"
                                Text="ACCIONES" />
                            <Button
                                x:Name="ColorDialogBtn"
                                Margin="0,0,0,8"
                                Click="ColorDialog_Click"
                                Content="Selector de colores"
                                Style="{StaticResource ActionButton}">
                                <Button.Background>
                                    <SolidColorBrush Color="#282014" />
                                </Button.Background>
                                <Button.BorderBrush>
                                    <SolidColorBrush Color="#6B5330" />
                                </Button.BorderBrush>
                                <Button.Foreground>
                                    <SolidColorBrush Color="#E8C88A" />
                                </Button.Foreground>
                            </Button>
                            <Button
                                x:Name="EyedropperBtn"
                                Margin="0,0,0,8"
                                Click="Eyedropper_Click"
                                Content="Cuentagotas"
                                Style="{StaticResource ActionButton}">
                                <Button.Background>
                                    <SolidColorBrush Color="#16281F" />
                                </Button.Background>
                                <Button.BorderBrush>
                                    <SolidColorBrush Color="#2E6B52" />
                                </Button.BorderBrush>
                                <Button.Foreground>
                                    <SolidColorBrush Color="#7FE0B8" />
                                </Button.Foreground>
                            </Button>

                            <Button
                                x:Name="RandomBtn"
                                Click="RandomColor_Click"
                                Content="Color aleatorio"
                                Style="{StaticResource ActionButton}">
                                <Button.Background>
                                    <SolidColorBrush Color="#221B33" />
                                </Button.Background>
                                <Button.BorderBrush>
                                    <SolidColorBrush Color="#4F3E75" />
                                </Button.BorderBrush>
                                <Button.Foreground>
                                    <SolidColorBrush Color="#C4AEF0" />
                                </Button.Foreground>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Style="{StaticResource LabelText}"
                                Text="FAVORITOS" />
                            <TextBlock
                                x:Name="FavCount"
                                Margin="8,0,50,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Style="{StaticResource HintText}"
                                Text="0/24" />
                            <Button
                                Padding="12,0"
                                Click="AddFavorite_Click"
                                Content="+ Agregar"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource HintText}"
                            Text="Clic para aplicar · Clic derecho para quitar" />
                        <ScrollViewer
                            MaxHeight="132"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FavoritesPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            Margin="3"
                                            CornerRadius="6"
                                            MouseDown="FavoriteColor_MouseDown"
                                            MouseRightButtonUp="FavoriteColor_Remove"
                                            Style="{StaticResource Swatch}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Color}" />
                                            </Border.Background>
                                            <ToolTipService.ToolTip>
                                                <TextBlock Text="{Binding Hex}" />
                                            </ToolTipService.ToolTip>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Style="{StaticResource LabelText}"
                                Text="HISTORIAL" />
                            <TextBlock
                                x:Name="HistCount"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Style="{StaticResource HintText}"
                                Text="0/24" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource HintText}"
                            Text="Los últimos colores usados" />
                        <ScrollViewer
                            MaxHeight="108"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HistoryPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="26"
                                            Height="26"
                                            Margin="2"
                                            CornerRadius="4"
                                            MouseDown="HistoryColor_MouseDown"
                                            Style="{StaticResource Swatch}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Color}" />
                                            </Border.Background>
                                            <ToolTipService.ToolTip>
                                                <TextBlock Text="{Binding Hex}" />
                                            </ToolTipService.ToolTip>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Barra de estado  -->
        <Border
            Grid.Row="3"
            Height="30"
            Margin="0,14,0,2"
            VerticalAlignment="Bottom"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="7"
                        Height="7"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource TextMutedBrush}" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="{StaticResource TextDimBrush}"
                        Text="Listo" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource HintText}"
                    Text="SelectColor v2.0" />
            </Grid>
        </Border>
    </Grid>
</Window>
